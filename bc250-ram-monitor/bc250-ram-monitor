#!/usr/bin/env python3
"""BC-250 RAM Monitor - shows how the AMD/ASRock BC-250's single 16 GB GDDR6
pool is split between the CPU (system RAM) and the GPU (VRAM carve-out + GTT).

GUI:  bc250-ram-monitor            (needs: sudo pacman -S python-gobject python-cairo gtk4)
TUI:  bc250-ram-monitor --cli      (no extra packages)
Once: bc250-ram-monitor --once     (print one report and exit)
Log:  bc250-ram-monitor --log FILE (append a CSV row every second, e.g. during LLM runs)
"""

import os
import sys
import time
from collections import deque

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, "/usr/share/bc250-ram-monitor")
import bc250_core as core  # noqa: E402
from bc250_core import fmt  # noqa: E402

INTERVAL = 1.0
HISTORY = 120

# colours (r, g, b) shared by GUI segments and legend
C_SYS_USED = (0.95, 0.45, 0.20)
C_SYS_CACHE = (0.98, 0.75, 0.35)
C_SYS_FREE = (0.30, 0.33, 0.38)
C_VRAM_USED = (0.85, 0.15, 0.25)
C_VRAM_FREE = (0.45, 0.18, 0.25)
C_GTT = (0.70, 0.30, 0.85)
C_RESV = (0.20, 0.20, 0.22)


# --------------------------------------------------------------------- text
def llm_lines(s: core.Snapshot, B: str = "", R: str = "") -> list[str]:
    g, t = s.gpu, s.ttm
    L = [f"{B}LLM / inference{R}"]
    if g:
        lim = f"TTM pages_limit {t.pages_limit} = {fmt(t.limit_bytes)}" if t.pages_limit \
            else "TTM pages_limit unknown"
        L.append(f"  GPU memory ceiling : {fmt(s.gpu_ceiling)}  (VRAM {fmt(g.vram_total)} + GTT "
                 f"{fmt(g.gtt_total)}, {lim})")
        L.append(f"  Headroom for model : {fmt(s.llm_headroom)} more weights / KV cache can load")
        if g.power_w is not None:
            L.append(f"  GPU power          : {g.power_w:.0f} W (SMU reading, uncalibrated)")
    L.append(f"  Paging             : swap-in {s.swap_in_rate:.0f}/s  swap-out {s.swap_out_rate:.0f}/s"
             f"  major faults {s.majflt_rate:.0f}/s  (should stay ~0 during inference)")
    if s.llm_procs:
        for p in s.llm_procs:
            adj = core.read_oom_adj(p.pid)
            L.append(f"  {p.name[:18]:<18} pid {p.pid:<7} RAM {fmt(p.rss):>11}  VRAM {fmt(p.vram):>11}"
                     f"  GTT {fmt(p.gtt):>11}  oom_adj {adj if adj is not None else '?'}")
    else:
        L.append("  No LLM runtime running (ollama, llama-server, koboldcpp, ...)")
    if s.ollama:
        for m in s.ollama:
            gpu_pct = 100 * m.size_vram / m.size if m.size else 0
            tps = core.BC250_BANDWIDTH / m.size if m.size else 0
            L.append(f"  ollama: {m.name:<24} {fmt(m.size):>11}  {gpu_pct:3.0f}% GPU"
                     + (f"  ctx {m.context}" if m.context else "")
                     + f"  ≈{tps:.0f} tok/s max*")
        L.append("  * dense-model ceiling = 357 GB/s ÷ model size; MoE models can go faster")
    elif s.ollama is not None:
        L.append("  ollama: no model loaded")
    return L


def report(s: core.Snapshot, color: bool = True) -> str:
    def bar(frac, width=40):
        frac = min(max(frac, 0), 1)
        n = int(round(frac * width))
        return "█" * n + "░" * (width - n)

    B = "\033[1m" if color else ""
    R = "\033[0m" if color else ""
    Y = "\033[33m" if color else ""
    g = s.gpu
    title = "ASRock / AMD BC-250" if (g and g.is_bc250) else "AMD APU (BC-250 not detected)"
    L = [f"{B}{title}  -  shared 16 GB GDDR6 pool{R}", ""]
    L.append(f"UMA mode : {s.uma_mode}")
    L.append(f"Pool     : {fmt(s.pool_total)} = system {fmt(s.mem_total)}"
             f" + VRAM carve-out {fmt(s.carveout)} + firmware {fmt(s.firmware_reserved)}")
    L += cpu_lines(s)
    L.append("")
    if s.mem_total:
        L.append(f"{B}System RAM{R}  {bar(s.used / s.mem_total)}  "
                 f"{fmt(s.used)} / {fmt(s.mem_total)}  ({100 * s.used / s.mem_total:.0f}%)")
        L.append(f"            cache {fmt(s.cache)}   available {fmt(s.mem_available)}")
    if g:
        if g.vram_total:
            L.append(f"{B}GPU VRAM{R}    {bar(g.vram_used / g.vram_total)}  "
                     f"{fmt(g.vram_used)} / {fmt(g.vram_total)}")
        if g.gtt_total:
            L.append(f"{B}GPU GTT{R}     {bar(g.gtt_used / g.gtt_total)}  "
                     f"{fmt(g.gtt_used)} / {fmt(g.gtt_total)}  (borrowed system RAM)")
        L.append(f"            GPU total in use: {fmt(s.gpu_total_used)}"
                 + (f"   sclk {g.sclk_mhz} MHz" if g.sclk_mhz else "")
                 + (f"   {g.temp_c:.0f} °C" if g.temp_c is not None else ""))
    if s.swap_total:
        L.append(f"{B}Swap{R}        {bar(s.swap_used / s.swap_total)}  "
                 f"{fmt(s.swap_used)} / {fmt(s.swap_total)}")
    for z in s.zram:
        ratio = (z.orig / z.compr) if z.compr else 0
        L.append(f"            {z.name}: {fmt(z.orig)} stored in {fmt(z.mem_used)} RAM"
                 f" (ratio {ratio:.1f}x, size {fmt(z.disksize)})")
    L += [""] + llm_lines(s, B, R)
    if s.procs:
        L += ["", f"{B}{'PID':>7}  {'PROCESS':<22}{'RAM':>12}{'VRAM':>12}{'GTT':>12}{R}"]
        for p in s.procs:
            L.append(f"{p.pid:>7}  {p.name[:21]:<22}{fmt(p.rss):>12}"
                     f"{fmt(p.vram) if p.vram else '-':>12}{fmt(p.gtt) if p.gtt else '-':>12}")
    if s.warnings:
        L.append("")
        for w in s.warnings:
            L.append(f"{Y}⚠ {w}{R}")
    return "\n".join(L)


def run_cli():
    rates = core.RateTracker()
    try:
        while True:
            s = core.snapshot(rates=rates)
            sys.stdout.write("\033[H\033[2J" + report(s) + "\n\n(Ctrl+C to quit)\n")
            sys.stdout.flush()
            time.sleep(INTERVAL)
    except KeyboardInterrupt:
        print()


def run_log(path: str):
    """Append one CSV row per second - handy for long LLM runs / benchmarks."""
    import csv
    import datetime
    cols = ["time", "sys_used", "sys_available", "vram_used", "gtt_used", "gpu_ceiling",
            "llm_headroom", "swap_used", "swap_out_per_s", "majflt_per_s", "sclk_mhz",
            "temp_c", "power_w", "llm_procs_rss", "ollama_models"]
    new = not os.path.exists(path)
    rates = core.RateTracker()
    print(f"Logging to {path} every {INTERVAL:.0f}s (Ctrl+C to stop)")
    with open(path, "a", newline="") as f:
        w = csv.writer(f)
        if new:
            w.writerow(cols)
        try:
            while True:
                s = core.snapshot(rates=rates)
                g = s.gpu or core.Gpu()
                w.writerow([datetime.datetime.now().isoformat(timespec="seconds"),
                            s.used, s.mem_available, g.vram_used, g.gtt_used, s.gpu_ceiling,
                            s.llm_headroom, s.swap_used, round(s.swap_out_rate),
                            round(s.majflt_rate), g.sclk_mhz, g.temp_c, g.power_w,
                            sum(p.rss for p in s.llm_procs),
                            ";".join(m.name for m in s.ollama or [])])
                f.flush()
                time.sleep(INTERVAL)
        except KeyboardInterrupt:
            print()


# ------------------------------------------------------------ 8-core unlock
UNLOCK_REPO = "https://github.com/GabriWar/bc250-core-cu-unlock"
GOVERNORS = "cyan-skillfish-governor-smu cyan-skillfish-governor"

# Runs as root via pkexec. The GPU clock governor talks to the same SMU mailbox as the
# unlock (message 0x98), so it is paused for the write and restarted afterwards.
APPLY_SH = f"""
tool="$1"; stopped=""
for g in {GOVERNORS}; do
  if systemctl is-active --quiet "$g"; then systemctl stop "$g" && stopped="$stopped $g"; fi
done
[ -n "$stopped" ] && echo "paused GPU governor:$stopped"
"$tool" apply; rc=$?
for g in $stopped; do systemctl start "$g"; done
exit $rc
"""
WARM_REBOOT_SH = "echo warm > /sys/kernel/reboot/mode 2>/dev/null; systemctl reboot"

UNLOCK_WARNING = (
    "This uses the bc250-8core-unlock script to flip the SMU core-enable mask from "
    "0x77 (6 cores) to 0xFF (8 cores).\n\n"
    "• The two extra cores may have been disabled for a reason. Stress-test them "
    "(stress-ng / mprime for a few hours) and watch dmesg for machine-check errors.\n"
    "• The cores appear only after a WARM reboot. A cold boot (power removed) reverts to "
    "6 cores, which is also the escape hatch if anything misbehaves.\n"
    "• The script refuses boards whose mask isn't the stock 0x77. Nothing is written to flash.\n"
    "• The extra cores share the SoC's power/thermal budget: re-check cooling and any "
    "GPU/CPU overclock or undervolt.\n"
    "• The new CPUs 12-15 get no idle C-states until you install the 8-core ACPI tables.\n\n"
    "You use this at your own risk.")


def cpu_lines(s: core.Snapshot) -> list[str]:
    c = s.cpu
    st = "UNLOCKED (8 cores)" if c.unlocked else ("stock (6 cores)" if c.cores == 6 else "?")
    L = [f"CPU cores : {c.cores} cores / {c.threads} threads - {st}"
         + (f"   Tctl {c.tctl_c:.0f} °C" if c.tctl_c is not None else "")]
    if not c.unlocked:
        L.append("            unlock tool: " + (c.unlock_tool or f"not installed ({UNLOCK_REPO})"))
    if c.boot_unit:
        L.append(f"            re-apply at boot: {'enabled' if c.boot_enabled else 'disabled'}")
    return L


