        # -------------------------------------------------- drawing
        def segments(self):
            s = self.snap
            g = s.gpu
            gtt = min(g.gtt_used if g else 0, s.used)
            cpu_used = max(0, s.used - gtt)
            cache = min(s.cache, max(0, s.mem_total - s.used))
            free = max(0, s.mem_total - s.used - cache)
            vu = g.vram_used if g else 0
            vf = max(0, (g.vram_total if g else 0) - vu)
            return [("sys_used", cpu_used, C_SYS_USED), ("gtt", gtt, C_GTT),
                    ("sys_cache", cache, C_SYS_CACHE), ("sys_free", free, C_SYS_FREE),
                    ("resv", s.firmware_reserved, C_RESV),
                    ("vram_used", vu, C_VRAM_USED), ("vram_free", vf, C_VRAM_FREE)]

        def draw_pool(self, _a, cr, w, h):
            if not self.snap:
                return
            total = sum(v for _, v, _ in self.segments()) or 1
            x = 0.0
            for _k, v, rgb in self.segments():
                sw = w * v / total
                cr.set_source_rgb(*rgb)
                cr.rectangle(x, 0, sw, h)
                cr.fill()
                x += sw
            # divider between system RAM and VRAM carve-out
            s = self.snap
            dx = w * (s.mem_total + s.firmware_reserved) / total
            cr.set_source_rgb(1, 1, 1)
            cr.set_line_width(2)
            cr.move_to(dx, 0)
            cr.line_to(dx, h)
            cr.stroke()

        def draw_graph(self, _a, cr, w, h):
            cr.set_source_rgba(0.5, 0.5, 0.5, 0.25)
            cr.set_line_width(1)
            for f in (0.25, 0.5, 0.75):
                cr.move_to(0, h * f)
                cr.line_to(w, h * f)
            cr.stroke()
            for data, rgb in ((self.hist_sys, C_SYS_USED), (self.hist_gpu, C_GTT)):
                step = w / (len(data) - 1)
                cr.move_to(0, h)
                for i, v in enumerate(data):
                    cr.line_to(i * step, h - v * h)
                cr.line_to(w, h)
                cr.close_path()
                cr.set_source_rgba(*rgb, 0.18)
                cr.fill_preserve()
                cr.new_path()
                for i, v in enumerate(data):
                    (cr.move_to if i == 0 else cr.line_to)(i * step, h - v * h)
                cr.set_source_rgb(*rgb)
                cr.set_line_width(2)
                cr.stroke()

        # -------------------------------------------------- 8-core unlock
        def run_root(self, argv, done):
            """Run argv through pkexec without blocking the UI; done(rc, output)."""
            self.busy = True
            self.update_cpu_buttons()
            try:
                proc = Gio.Subprocess.new(["pkexec"] + argv, Gio.SubprocessFlags.STDOUT_PIPE
                                          | Gio.SubprocessFlags.STDERR_MERGE)
            except GLib.Error as e:
                self.busy = False
                done(127, f"could not start pkexec: {e.message}")
                return

            def fin(p, res):
                try:
                    _ok, out, _err = p.communicate_utf8_finish(res)
                except GLib.Error as e:
                    out = e.message
                rc = p.get_exit_status()
                if rc in (126, 127) and not (out or "").strip():
                    out = "authentication cancelled or not authorised"
                self.busy = False
                done(rc, (out or "").strip())
                self.refresh()
            proc.communicate_utf8_async(None, None, fin)

        def show_out(self, text):
            self.cpu_out.set_label(text)
            self.cpu_out.set_visible(bool(text))

        def ask(self, message, detail, buttons, cb, default=0):
            dlg = Gtk.AlertDialog(message=message, detail=detail, buttons=buttons,
                                  cancel_button=0, default_button=default, modal=True)

            def done(d, res):
                try:
                    cb(d.choose_finish(res))
                except GLib.Error:
                    pass
            dlg.choose(self, None, done)

        def tool_missing(self):
            self.ask("Unlock tool not installed",
                     "The 8-core unlock uses GabriWar's MIT-licensed script. Read it, then "
                     "install it:\n\n"
                     f"git clone {UNLOCK_REPO}\n"
                     "cd bc250-core-cu-unlock\n"
                     "sudo pacman -S --needed pciutils\n"
                     "sudo install -Dm755 bc250-8core-unlock.sh /usr/local/bin/bc250-8core-unlock\n\n"
                     "Then press the button again.", ["Close"], lambda _i: None)

        def on_unlock(self, _b):
            tool = self.snap.cpu.unlock_tool
            if not tool:
                return self.tool_missing()

            def go(i):
                if i != 1:
                    return

                def done(rc, out):
                    self.show_out(out)
                    if rc == 0 and ("unlocked." in out or "already unlocked" in out):
                        self.mask_set = True
                        self.ask("Mask set to 0xFF",
                                 "All 8 cores will appear after a warm reboot. "
                                 "A cold boot reverts to 6.", ["Later", "Warm reboot now"],
                                 lambda j: j == 1 and self.do_reboot(), default=1)
                self.run_root(["sh", "-c", APPLY_SH, "sh", tool], done)
            self.ask("Unlock all 8 CPU cores?", UNLOCK_WARNING, ["Cancel", "Unlock"], go)

        def on_check(self, _b):
            tool = self.snap.cpu.unlock_tool
            if not tool:
                return self.tool_missing()

            def done(rc, out):
                self.show_out(out)
                if "state: UNLOCKED" in out and not self.snap.cpu.unlocked:
                    self.mask_set = True
            self.run_root([tool, "status"], done)

        def on_reboot(self, _b):
            self.ask("Warm reboot now?", "Save your work first. The system restarts with a warm "
                     "reset so the 0xFF core mask survives.", ["Cancel", "Reboot"],
                     lambda i: i == 1 and self.do_reboot())

        def do_reboot(self):
            self.run_root(["sh", "-c", WARM_REBOOT_SH], lambda rc, out: rc and self.show_out(out))

        def on_boot_toggle(self, sw, state):
            c = self.snap.cpu
            if state == c.boot_enabled:
                return False
            if state and not c.unlock_tool:
                self.tool_missing()
                return True        # keep switch unchanged
            if state:
                # the script's own installer: copies itself to /usr/local/bin, writes + enables unit
                argv = ([ "systemctl", "enable", core.UNLOCK_UNIT] if c.boot_unit
                        else [c.unlock_tool, "install"])
            else:
                argv = ["systemctl", "disable", core.UNLOCK_UNIT]
            self.run_root(argv, lambda rc, out: self.show_out(out))
            return True            # refresh() sets the real state from disk

        def update_cpu_buttons(self):
            c = self.snap.cpu if self.snap else None
            if not c:
                return
            self.unlock_btn.set_visible(not c.unlocked and not self.mask_set)
            self.unlock_btn.set_sensitive(not self.busy and not self.mask_set)
            self.reboot_btn.set_visible(self.mask_set and not c.unlocked)
            self.reboot_btn.set_sensitive(not self.busy)
            self.check_btn.set_sensitive(not self.busy)
            self.boot_sw.set_sensitive(not self.busy)

        # -------------------------------------------------- refresh
        def refresh(self):
            want_procs = self.tick % 3 == 0 or self.snap is None
            s = core.snapshot(procs=want_procs, rates=self.rates)
            if not want_procs and self.snap:
                s.procs, s.llm_procs, s.ollama = self.snap.procs, self.snap.llm_procs, self.snap.ollama
                s.warnings = core.build_warnings(s)
            self.tick += 1
            self.snap = s
            g = s.gpu

            if g and g.is_bc250:
                self.title.set_label("ASRock / AMD BC-250")
            else:
                self.title.set_label("BC-250 RAM Monitor (BC-250 GPU not detected)")
            extra = f"  ·  GPU {g.card} {g.device_id}" if g else ""
            if g and g.sclk_mhz:
                extra += f"  ·  {g.sclk_mhz} MHz"
            if g and g.temp_c is not None:
                extra += f"  ·  {g.temp_c:.0f} °C"
            self.subtitle.set_label(f"UMA: {s.uma_mode}{extra}")

            c = s.cpu
            self.ccard.set_visible(bool(g and g.is_bc250))
            self.cpu_val.set_label(f"{c.cores} cores / {c.threads} threads  ·  "
                                   + ("unlocked" if c.unlocked else "stock" if c.cores == 6 else "?"))
            det = [f"Tctl {c.tctl_c:.0f} °C"] if c.tctl_c is not None else []
            if c.unlocked:
                det.append("All 8 Zen 2 cores active (reverts on a cold boot unless the boot unit is on)")
            elif self.mask_set:
                det.append("Mask is 0xFF - warm reboot to bring up the two extra cores")
            elif not c.unlock_tool:
                det.append("Unlock tool not installed - the button explains how")
            self.cpu_det.set_label("  ·  ".join(det))
            self.boot_sw.handler_block(self.boot_sw_handler)
            self.boot_sw.set_active(c.boot_enabled)
            self.boot_sw.set_state(c.boot_enabled)
            self.boot_sw.handler_unblock(self.boot_sw_handler)
            self.update_cpu_buttons()

            vals = {k: v for k, v, _ in self.segments()}
            for k, (lbl, name) in self.legend_lbl.items():
                lbl.set_label(f"{name}  {fmt(vals.get(k, 0))}")

            def setc(key, used, total, detail):
                val, bar, det = self.stats[key]
                if total:
                    val.set_label(f"{fmt(used)} / {fmt(total)}")
                    bar.set_value(min(1, used / total))
                else:
                    val.set_label("n/a")
                    bar.set_value(0)
                det.set_label(detail)

            setc("sys", s.used, s.mem_total,
                 f"{100 * s.used / max(1, s.mem_total):.0f}% used · cache {fmt(s.cache)} · "
                 f"available {fmt(s.mem_available)}")
            if g:
                setc("vram", g.vram_used, g.vram_total,
                     "BIOS carve-out (UMA frame buffer)"
                     + (f" · CPU-visible {fmt(g.vis_vram_used)}/{fmt(g.vis_vram_total)}"
                        if g.vis_vram_total and g.vis_vram_total != g.vram_total else ""))
                setc("gtt", g.gtt_used, g.gtt_total,
                     f"System RAM borrowed by the GPU · GPU total {fmt(s.gpu_total_used)}")
            else:
                setc("vram", 0, 0, "amdgpu not found")
                setc("gtt", 0, 0, "")
            zd = " · ".join(f"{z.name}: {fmt(z.orig)}→{fmt(z.mem_used)}" for z in s.zram)
            setc("swap", s.swap_used, s.swap_total, zd or "no zram devices")

            if g:
                ceil = max(1, s.gpu_ceiling)
                self.llm_head.set_label(fmt(s.llm_headroom))
                lim = f"TTM limit {fmt(s.ttm.limit_bytes)}" if s.ttm.pages_limit else "TTM limit unknown"
                self.llm_ceiling.set_label(
                    f"GPU ceiling {fmt(s.gpu_ceiling)}\nVRAM {fmt(g.vram_total)} + GTT "
                    f"{fmt(g.gtt_total)} · {lim}"
                    + (f"\nGPU power {g.power_w:.0f} W (uncalibrated)" if g.power_w is not None else ""))
                self.llm_bar.set_value(min(1, s.gpu_total_used / ceil))
            skip = ("LLM", "  GPU memory ceiling", "  Headroom", "  GPU power")
            self.llm_lbl.set_label("\n".join(x.strip() for x in llm_lines(s) if not x.startswith(skip)))

            pool = max(1, s.pool_total)
            self.hist_sys.append(s.used / max(1, s.mem_total))
            self.hist_gpu.append(min(1, s.gpu_total_used / pool))

            child = self.warn_box.get_first_child()
            while child:
                nxt = child.get_next_sibling()
                self.warn_box.remove(child)
                child = nxt
            for wtxt in s.warnings:
                self.warn_box.append(Gtk.Label(label="⚠ " + wtxt, xalign=0, wrap=True,
                                               css_classes=["warn"]))

            rows = [f"{'PID':>7}  {'PROCESS':<20}{'RAM':>11}{'VRAM':>11}{'GTT':>11}"]
            for p in s.procs:
                rows.append(f"{p.pid:>7}  {p.name[:19]:<20}{fmt(p.rss):>11}"
                            f"{fmt(p.vram) if p.vram else '-':>11}{fmt(p.gtt) if p.gtt else '-':>11}")
            self.proc_lbl.set_label("\n".join(rows))

            self.pool.queue_draw()
            self.graph.queue_draw()
            return True

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="io.github.bc250.RamMonitor")

        def do_activate(self):
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            from gi.repository import Gdk
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            (self.props.active_window or Win(self)).present()

    return App().run([sys.argv[0]])


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__)
        return 0
    if "--once" in args:
        print(report(core.snapshot(), color=sys.stdout.isatty()))
        return 0
    if "--log" in args:
        i = args.index("--log")
        run_log(args[i + 1] if i + 1 < len(args) else "bc250-ram-log.csv")
        return 0
    if "--cli" in args:
        run_cli()
        return 0
    try:
        return run_gui()
    except (ImportError, ValueError, TypeError) as e:
        print(f"GTK4 GUI unavailable ({e}).\n"
              "Install it with:  sudo pacman -S python-gobject python-cairo gtk4\n"
              "Falling back to terminal mode...\n", file=sys.stderr)
        time.sleep(2)
        run_cli()
        return 0


if __name__ == "__main__":
    sys.exit(main())
